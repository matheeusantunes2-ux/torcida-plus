# Django
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-this-local-development-key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
DJANGO_TIME_ZONE=America/Sao_Paulo

# Database: sqlite (default) or postgres
DB_ENGINE=sqlite
SQLITE_PATH=backend/db.sqlite3
# For PostgreSQL, set DB_ENGINE=postgres and configure:
POSTGRES_DB=torcida_plus
POSTGRES_USER=torcida_plus
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DB_CONN_MAX_AGE=60

# JWT lifetime
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# Browser clients only; native mobile requests do not use browser CORS.
CORS_ALLOWED_ORIGINS=http://localhost:19006,http://localhost:8081,http://127.0.0.1:8081
CSRF_TRUSTED_ORIGINS=
SECURE_SSL_REDIRECT=true
