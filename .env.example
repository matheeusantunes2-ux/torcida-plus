# Django — este arquivo é um exemplo para desenvolvimento local.
# Em produção (Render), configure DJANGO_DEBUG=false no painel de Environment.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-this-local-development-key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
DJANGO_TIME_ZONE=America/Sao_Paulo

# Database: sqlite (default) or postgres
DB_ENGINE=sqlite
SQLITE_PATH=backend/db.sqlite3
# For PostgreSQL, set DB_ENGINE=postgres and configure:
POSTGRES_DB=torcida_plus
POSTGRES_USER=torcida_plus
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DB_CONN_MAX_AGE=60

# JWT lifetime
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# Browser clients only; native mobile requests do not use browser CORS.
CORS_ALLOWED_ORIGINS=http://localhost:19006,http://localhost:8081,http://127.0.0.1:8081
CSRF_TRUSTED_ORIGINS=
SECURE_SSL_REDIRECT=true

# Produção no Render:
# - DJANGO_SECRET_KEY: gere uma chave aleatória forte e exclusiva no painel.
# - DJANGO_ALLOWED_HOSTS: hostname .onrender.com e domínios personalizados, separados por vírgula.
# - REDIS_URL: URL privada do Redis/Key Value usado pelo serviço.
# - CORS_ALLOWED_ORIGINS e CSRF_TRUSTED_ORIGINS: informe somente as origens HTTPS reais do frontend.
# - SECURE_HSTS_SECONDS: padrão de produção é 31536000 (1 ano); reduza temporariamente
#   somente durante validação inicial ou migração de domínio, se necessário.
# Nunca copie a chave de exemplo nem credenciais de desenvolvimento para produção.
